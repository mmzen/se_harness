import hashlib
import json
import shutil
from pathlib import Path

root = Path(__file__).resolve().parent
product = root.parents[1] / 'se-harness-plugin-retained-skills'
src = product / 'plugins/verity-plane/common/skills'
dest = root / 'candidate-final'
assert not dest.exists()
for name in ['harness-orient', 'harness-operator-brief']:
    shutil.copytree(src / name, dest / name)
identity = json.loads((root / 'accepted-fixture-package-identity.json').read_text())
expected = {r['path']: r['raw_sha256'] for r in identity['files']}
expected['harness-operator-brief/SKILL.md'] = '3e39fc61f7dfb41ca2b54d2c78f03ef2a7f3391402492dcd3ccef39a50a4af51'
actual = {p.relative_to(dest).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in dest.rglob('*') if p.is_file()}
assert actual == expected
records = []
cores = {}
for name in ['harness-orient', 'harness-operator-brief']:
    entries = []
    for path in sorted((dest / name).rglob('*')):
        if not path.is_file():
            continue
        relative = path.relative_to(dest / name).as_posix()
        normalized = path.read_bytes().decode('utf8').replace('\r\n', '\n').replace('\r', '\n').encode('utf8')
        entries.append({'mode': 'utf8-text-lf-v1', 'path': relative, 'sha256': hashlib.sha256(normalized).hexdigest()})
    entries.sort(key=lambda r: r['path'].encode('utf8'))
    manifest = {'files': entries, 'schema': 'se-harness-skill-manifest-v1'}
    digest = hashlib.sha256(json.dumps(manifest, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode('utf8')).hexdigest()
    cores[name] = {'manifest': manifest, 'sha256': digest}
fixed = {'classification': 'test-only accepted fixture identity; not production publisher trust', 'raw_sha256': expected, 'cores': cores}
(root / 'accepted-final-fixture-package-identity.json').write_text(json.dumps(fixed, indent=2) + '\n')
boundary = root / 'boundary-final'
boundary.mkdir()
for name in ['boundary_runner.py', 'audit_worker.py']:
    shutil.copyfile(product / 'tests/plugin_integration/retained-skills' / name, boundary / name)
settings = json.loads((root / 'boundary-v1/settings.json').read_text())
settings['helpers'] = {'orient': str(dest / 'harness-orient/scripts/orient.py'), 'brief': str(dest / 'harness-operator-brief/scripts/check_brief.py')}
settings['product_sha256'] = {str(dest / relative): digest for relative, digest in expected.items()}
settings['read_roots'].append(str(dest))
(boundary / 'settings.json').write_text(json.dumps(settings, indent=2) + '\n')
print(json.dumps({'verified': True, 'cores': {name: core['sha256'] for name, core in cores.items()}, 'instrumentation_sha256': {name: hashlib.sha256((boundary / name).read_bytes()).hexdigest() for name in ['boundary_runner.py', 'audit_worker.py']}}))
