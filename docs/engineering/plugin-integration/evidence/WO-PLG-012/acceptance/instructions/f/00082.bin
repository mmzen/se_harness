"""Package the model's selected literal render; no activation or policy routing."""
import hashlib
import json
from pathlib import Path

root = Path(__file__).resolve().parent
raw = json.loads((root / 'raw-inputs.json').read_text(encoding='utf8'))
source = raw['C05-unicode']
original = source['source_text'].encode('utf8')
assert hashlib.sha256(original).hexdigest() == '66cedd5c2b34274a387fdac6d0db62b3b716b8531603fff0cd4b0ce60727ccb9'
assert original == (root / 'C05-unicode-source.txt').read_bytes()
last = 0
for span in source['protected_spans']:
    assert last <= span['start'] < span['end'] <= len(original)
    assert hashlib.sha256(original[span['start']:span['end']]).hexdigest() == span['sha256']
    last = span['end']

# The following prose was selected by the model only after actual version,
# released identity and doctor passed. It is not generated by an oracle/engine.
rendered = ('The Café example describes a prepared record: VREC-BRF-001.\n\n'
            'The supplied inspection command is `harnessctl check . --artifact VREC-BRF-001 --json`.\n'
            'The supplied code example is `print("naïve café ☕")`.\n\n'
            'Only the assurance owner may verify VREC-BRF-001 when the retained evidence is sufficient; preparation grants no merge or release authority.\n\n'
            'This brief explains the supplied example and does not report current repository state.\n')
output_bytes = rendered.encode('utf8')
bindings = []
cursor = 0
for span in source['protected_spans']:
    piece = original[span['start']:span['end']]
    position = output_bytes.index(piece, cursor)
    bindings.append({'id': span['id'], 'start': position, 'end': position + len(piece), 'sha256': hashlib.sha256(piece).hexdigest()})
    cursor = position + len(piece)
request = {key: source[key] for key in ['explicit_skill', 'source_kind', 'source_text', 'source_sha256', 'protected_spans']}
request.update({'profile': 'operator-communication', 'rendered_text': rendered, 'bindings': bindings, 'changed_paths': []})
out = root / 'C05-unicode-request.json'
assert not out.exists()
out.write_bytes(json.dumps(request, ensure_ascii=False, indent=2).encode('utf8') + b'\n')
(root / 'C05-unicode-rendered.txt').write_bytes(output_bytes)
print(json.dumps({'source_sha256': source['source_sha256'], 'rendered_sha256': hashlib.sha256(output_bytes).hexdigest(), 'bindings': bindings, 'pre_render_source_guard': 'passed'}))
