tion);\n    }\n    component.state.data = component._bundle;\n    component.state.selId = 'RLS-TST-001';\n    outcomes.push({id, status, selected: component.renderVals().sel.roster.rows[0].vrecId});\n  }\n}\nprocess.stdout.write(JSON.stringify(outcomes));\n"
