{
  "schema": "se-harness-skill-contract-v2",
  "name": "harness-execute-work-order",
  "version": "1.0.2",
  "outcome": "Execute one already-started bounded work order and retain its evidence without completing or delivering it.",
  "activation": {
    "explicit": true,
    "implicit": false,
    "must_not_match": [
      "explain or review a work order",
      "start an approved work order",
      "mark a work order implemented",
      "commit, push, publish, deploy, operate, or use credentials"
    ]
  },
  "inputs": [
    {"name": "target", "required": true, "type": "repository-path"},
    {"name": "evaluator-launcher", "required": true, "type": "evaluator-launcher"},
    {"name": "expected-evaluator-version", "required": true, "type": "version"},
    {"name": "expected-evaluator-root", "required": true, "type": "directory-path"},
    {"name": "explicit-skill", "required": true, "type": "skill-name"},
    {"name": "requested-outcome", "required": true, "type": "bounded-text"},
    {"name": "declared-non-effects", "required": true, "type": "text-list"},
    {"name": "work-order", "required": true, "type": "artifact-id"},
    {"name": "focus-result", "required": true, "type": "json-object"},
    {"name": "preflight-result", "required": true, "type": "json-object"},
    {"name": "execution-scope", "required": true, "type": "path-list"},
    {"name": "verification-contracts", "required": true, "type": "artifact-id-list"},
    {"name": "evidence-obligations", "required": true, "type": "path-list"},
    {"name": "repository-commands", "required": true, "type": "command-array"},
    {"name": "implementation-constraints", "required": false, "type": "text-list"}
  ],
  "preconditions": [
    {"id": "explicit-selection", "description": "The operator explicitly selected harness-execute-work-order and exactly one work order."},
    {"id": "released-evaluator", "description": "The supplied external evaluator identity and installed integrity are current."},
    {"id": "work-already-started", "description": "Current evaluator focus reports the selected work order in_progress."},
    {"id": "scope-loaded", "description": "The complete current execution scope, verification contracts, commands, and evidence obligations were read."}
  ],
  "mutation_class": "governed-mutation",
  "evaluator": {
    "minimum_version": "0.6.0",
    "required_operations": ["version", "identity", "doctor", "validate-json", "focus-json", "preflight", "check", "raise-risk"],
    "optional_operations": ["inspect-json"],
    "missing_required": "blocked",
    "missing_optional": "degraded"
  },
  "checkpoints": [
    {"id": "identity-before-effect", "stage": "before-effect", "operation": "identity", "required": true},
    {"id": "integrity-before-effect", "stage": "before-effect", "operation": "doctor", "required": true},
    {"id": "work-state-before-effect", "stage": "before-effect", "operation": "focus-json", "required": true},
    {"id": "scope-before-effect", "stage": "before-effect", "operation": "preflight", "required": true},
    {"id": "review-after-effect", "stage": "after-effect", "operation": "check", "required": true},
    {"id": "implementation-handoff", "stage": "handoff", "operation": "focus-json", "required": true}
  ],
  "effects": {
    "permitted": ["implementation-write", "test-execution", "evidence-write", "risk-raise"],
    "prohibited": ["accountable-approval", "assurance-decision", "credential-use", "delivery-selection", "external-action", "git-mutation", "lifecycle-transition", "network-mutation", "release-decision", "verification-decision", "work-completion", "work-start"],
    "path_source": "work-order-execution-scope",
    "lifecycle_transitions": []
  },
  "delegation": {"allowed": false, "fallback": "single-agent"},
  "evidence": {
    "receipt_schema": "se-harness-execution-receipt-v1",
    "target_retention": true,
    "required_retained_kinds": ["work-order-evidence"]
  },
  "stop_conditions": [
    {"id": "implicit-or-ambiguous-activation", "outcome": "blocked"},
    {"id": "work-order-not-in-progress", "outcome": "stopped"},
    {"id": "path-outside-scope", "outcome": "blocked"},
    {"id": "failed-required-check", "outcome": "failed"},
    {"id": "work-completion-decision", "outcome": "stopped"}
  ],
  "outputs": [
    {"name": "skill-result", "schema": "se-harness-skill-result-v1", "retention": "inline"},
    {"name": "execution-receipt", "schema": "se-harness-execution-receipt-v1", "retention": "inline"},
    {"name": "work-order-evidence", "schema": "se-harness-evidence-set-v1", "retention": "retained"}
  ]
}
