{
  "schema": "se-harness-skill-contract-v2",
  "name": "harness-prepare-assurance",
  "version": "1.0.1",
  "outcome": "Prepare one exact-candidate ready verification record and assurance decision packet without verifying or delivering it.",
  "activation": {
    "explicit": true,
    "implicit": false,
    "must_not_match": [
      "review implementation evidence",
      "verify or reject a verification record",
      "select a delivery path",
      "commit, push, publish, deploy, operate, or use credentials"
    ]
  },
  "inputs": [
    {"name": "target", "required": true, "type": "repository-path"},
    {"name": "evaluator-launcher", "required": true, "type": "evaluator-launcher"},
    {"name": "expected-evaluator-version", "required": true, "type": "version"},
    {"name": "expected-evaluator-root", "required": true, "type": "directory-path"},
    {"name": "explicit-skill", "required": true, "type": "skill-name"},
    {"name": "requested-outcome", "required": true, "type": "bounded-text"},
    {"name": "declared-non-effects", "required": true, "type": "text-list"},
    {"name": "work-orders", "required": true, "type": "artifact-id-list"},
    {"name": "verification-contracts", "required": true, "type": "artifact-id-list"},
    {"name": "evidence-paths", "required": true, "type": "path-list"},
    {"name": "candidate-commit", "required": true, "type": "bounded-text"},
    {"name": "record-id", "required": true, "type": "artifact-id"},
    {"name": "record-destination", "required": true, "type": "repository-path"},
    {"name": "preparation-actor", "required": true, "type": "bounded-text"}
  ],
  "preconditions": [
    {"id": "explicit-selection", "description": "The operator explicitly selected harness-prepare-assurance and one unused VREC identifier."},
    {"id": "released-evaluator", "description": "The supplied external evaluator identity and installed integrity are current."},
    {"id": "implemented-work", "description": "Every selected work order is implemented and governed by the selected verification contracts."},
    {"id": "clean-candidate", "description": "The evaluator observes the exact clean candidate and all retained evidence."},
    {"id": "preparation-actor", "description": "The current request names the actor recorded as preparer, not verifier."}
  ],
  "mutation_class": "governed-mutation",
  "evaluator": {
    "minimum_version": "0.6.0",
    "required_operations": ["version", "identity", "doctor", "validate-json", "focus-json", "preflight", "capture-verification"],
    "optional_operations": ["inspect-json"],
    "missing_required": "blocked",
    "missing_optional": "degraded"
  },
  "checkpoints": [
    {"id": "identity-before-effect", "stage": "before-effect", "operation": "identity", "required": true},
    {"id": "integrity-before-effect", "stage": "before-effect", "operation": "doctor", "required": true},
    {"id": "candidate-before-effect", "stage": "before-effect", "operation": "preflight", "required": true},
    {"id": "ready-record-after-effect", "stage": "after-effect", "operation": "focus-json", "required": true},
    {"id": "assurance-handoff", "stage": "handoff", "operation": "focus-json", "required": true}
  ],
  "effects": {
    "permitted": ["verification-record-prepare"],
    "prohibited": ["accountable-approval", "assurance-decision", "credential-use", "delivery-selection", "external-action", "git-mutation", "lifecycle-transition", "network-mutation", "release-decision", "verification-decision", "work-completion", "work-start"],
    "path_source": "evaluator-derived-vrec-destination",
    "lifecycle_transitions": []
  },
  "delegation": {"allowed": false, "fallback": "single-agent"},
  "evidence": {
    "receipt_schema": "se-harness-execution-receipt-v1",
    "target_retention": true,
    "required_retained_kinds": ["verification-record", "evaluator-evidence"]
  },
  "stop_conditions": [
    {"id": "implicit-or-ambiguous-activation", "outcome": "blocked"},
    {"id": "candidate-not-ready", "outcome": "stopped"},
    {"id": "record-id-collision", "outcome": "blocked"},
    {"id": "missing-preparation-actor", "outcome": "blocked"},
    {"id": "assurance-decision-required", "outcome": "stopped"}
  ],
  "outputs": [
    {"name": "skill-result", "schema": "se-harness-skill-result-v1", "retention": "inline"},
    {"name": "execution-receipt", "schema": "se-harness-execution-receipt-v1", "retention": "inline"},
    {"name": "assurance-decision-packet", "schema": "se-harness-decision-packet-v1", "retention": "inline"}
  ]
}
