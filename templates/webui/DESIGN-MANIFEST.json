{
  "schema": "se-harness-design-handoff-v1",
  "title": "Harness Explorer",
  "status": "implementation-ready",
  "governingSpecification": "SPEC-DST-008",
  "dataContract": {
    "schema": "harness-dashboard-snapshot-v1",
    "marker": "__HARNESS_SNAPSHOT_JSON__",
    "canonicalOutput": "target/harness-dashboard/dashboard-data.json",
    "runSummary": "target/harness-dashboard/generation-summary.json",
    "persistedPresentationSchema": false,
    "deterministic": true
  },
  "sourceFiles": {
    "all": [
      "harness-lineage-prototype.html",
      "harness-dashboard-data.md",
      "harness-dashboard-data.schema.json",
      "brand-spec.md",
      "DESIGN-HANDOFF.md",
      "DESIGN-MANIFEST.json"
    ],
    "missing": []
  },
  "views": [
    {
      "id": "explain",
      "question": "Why does this exist?",
      "sources": ["artifacts", "relations", "revision_provenance", "evidence"]
    },
    {
      "id": "coverage",
      "question": "Is the definition covered?",
      "sources": ["coverage"]
    },
    {
      "id": "impact",
      "question": "What needs reassessment?",
      "sources": ["relations"]
    },
    {
      "id": "findings",
      "question": "What is inconsistent or unassessable?",
      "sources": ["diagnostics", "findings", "readiness", "revision_provenance", "revision_policy"]
    },
    {
      "id": "compare",
      "question": "Does the harness help?",
      "sources": ["experiments"]
    }
  ],
  "security": {
    "runtimeNetwork": true,
    "remoteFonts": false,
    "thirdPartyRuntimeAssets": [
      {
        "name": "3d-force-graph",
        "version": "1.79.0",
        "url": "https://unpkg.com/3d-force-graph@1.79.0/dist/3d-force-graph.min.js",
        "purpose": "Preserve the reviewed interactive 3D repository topology",
        "integrityPinned": false,
        "riskOwner": "ADR-DST-008"
      }
    ],
    "repositoryDataTrusted": false,
    "dynamicHtmlFromRepositoryData": false,
    "contentSecurityPolicy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline' https://unpkg.com; img-src data:; connect-src 'none'; font-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
  },
  "semantics": {
    "authoritySource": "formal artifacts and validator",
    "definitionCoverageIsCommitVerification": false,
    "aggregateHealthScore": false,
    "readinessStates": ["satisfied", "unsatisfied", "not_assessable"],
    "relationAuthorities": ["declared", "derived"],
    "unknownTypes": "render-neutral",
    "supersessionDirection": "old-to-successor"
  },
  "responsiveChecks": [
    "1440x900",
    "1024x768",
    "390x844"
  ],
  "requiredStates": [
    "valid",
    "invalid",
    "unsupported-schema",
    "empty-artifacts",
    "missing-target",
    "not-assessable",
    "superseded",
    "no-evidence",
    "no-experiments",
    "bounded-visual"
  ]
}
