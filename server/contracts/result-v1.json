{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:se-harness:remote-result:v1",
  "title": "Phase 1 accepted command receipts and protocol refusals",
  "$ref": "#/$defs/Result",
  "$defs": {
    "Accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "se-harness-remote-result/v1"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "view": {
          "oneOf": [
            {
              "$ref": "urn:se-harness:graph-read:v1#/$defs/View"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "before": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "after": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              },
              "required": [
                "before",
                "after"
              ]
            },
            "context": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "context_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "before": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "after": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    }
                  },
                  "required": [
                    "context_id",
                    "before",
                    "after"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "project",
            "context"
          ]
        },
        "affected_revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maxItems": 2500
        },
        "affected_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Z]+-[A-Z0-9]+-[0-9]{3,}$"
              },
              "revision_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "artifact_id",
              "revision_id"
            ]
          },
          "maxItems": 2500
        },
        "evaluator": {
          "$ref": "urn:se-harness:remote-wire:v1#/$defs/Evaluator"
        },
        "evaluator_output": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "const": "accepted"
        },
        "http_status": {
          "const": 200
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "schema",
        "operation_key",
        "request_digest",
        "project_id",
        "view",
        "versions",
        "affected_revision_ids",
        "affected_artifacts",
        "evaluator",
        "evaluator_output",
        "outcome",
        "http_status",
        "receipt_id"
      ]
    },
    "RefusedFields": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "se-harness-remote-result/v1"
        },
        "operation_key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "request_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "view": {
          "oneOf": [
            {
              "$ref": "urn:se-harness:graph-read:v1#/$defs/View"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "project": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "before": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "after": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    }
                  },
                  "required": [
                    "before",
                    "after"
                  ]
                },
                "context": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "context_id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "before": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "after": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        }
                      },
                      "required": [
                        "context_id",
                        "before",
                        "after"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "project",
                "context"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_revision_ids": {
          "type": "array",
          "maxItems": 0
        },
        "affected_artifacts": {
          "type": "array",
          "maxItems": 0
        },
        "evaluator": {
          "oneOf": [
            {
              "$ref": "urn:se-harness:remote-wire:v1#/$defs/Evaluator"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluator_output": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "const": "refused"
        },
        "receipt_id": {
          "type": "null"
        }
      },
      "required": [
        "schema",
        "operation_key",
        "request_digest",
        "project_id",
        "view",
        "versions",
        "affected_revision_ids",
        "affected_artifacts",
        "evaluator",
        "evaluator_output",
        "outcome",
        "receipt_id"
      ]
    },
    "Refused": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 400
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_MALFORMED",
                        "HAG_REMOTE_UNSUPPORTED_OPERATION",
                        "HAG_REMOTE_QUERY_SYNTAX"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 401
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_UNAUTHENTICATED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 403
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_FORBIDDEN"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 404
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_UNKNOWN_IDENTITY",
                        "HAG_REMOTE_OPERATION_UNKNOWN"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 409
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_STALE_PROJECT",
                        "HAG_REMOTE_STALE_CONTEXT",
                        "HAG_REMOTE_STALE_REVISION",
                        "HAG_REMOTE_KEY_REUSE",
                        "HAG_REMOTE_UNSUPPORTED_TUPLE",
                        "HAG_REMOTE_SOURCE_MISMATCH",
                        "HAG_REMOTE_SCHEMA_MISMATCH"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 422
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_INVALID_DRAFT",
                        "HAG_REMOTE_INVALID_IMPORT",
                        "HAG_REMOTE_INCOMPLETE_SELECTION",
                        "HAG_REMOTE_PROTECTED_FIELD",
                        "HAG_REMOTE_BINDING_UNAVAILABLE"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RefusedFields"
            },
            {
              "type": "object",
              "properties": {
                "http_status": {
                  "const": 429
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "HAG_REMOTE_RESOURCE_LIMIT"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "required": [
                "http_status",
                "error"
              ]
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "Result": {
      "oneOf": [
        {
          "$ref": "#/$defs/Accepted"
        },
        {
          "$ref": "#/$defs/Refused"
        }
      ]
    }
  },
  "description": "Accepted receipts are immutable; an equal retry and operation lookup return the original object. A refusal has no receipt or effects. Null fields avoid inventing unavailable or unauthorized identities. For read refusals, command correlation and versions are null. Transport loss is not a refused result."
}
