  "mechanics": [
    {
      "id": "release-record-format-validation",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": [],
      "realized_by": "shell-composition",
      "summary": "Refuse any release_record input that is not a canonical RLS identifier before anything else runs."
    },
    {
      "id": "evaluator-resolution",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python .github/scripts/publish_dashboard.py evaluator"],
      "realized_by": "repository-program",
      "summary": "Resolve the independently released evaluator identity, wheel name, URL, and digests from the governance snapshot."
    },
    {
      "id": "evaluator-acquisition-and-hash-proof",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python -m venv", "curl", "sha256sum", "python -m pip install"],
      "realized_by": "platform-toolchain",
      "summary": "Create the evaluator environment, fetch the public evaluator wheel, prove its digest before use, and install it without dependencies."
    },
    {
      "id": "evaluator-identity-proof",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python -m se_harness identity"],
      "realized_by": "released-evaluator",
      "summary": "Prove the installed evaluator's released-evaluator role, version, isolated interpreter, and console entry point."
    },
    {
      "id": "predecessor-view-qualification",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python -m se_harness qualify predecessor-view"],
      "realized_by": "candidate-cli",
      "summary": "Qualify the contract-bound release view against its exact external predecessor evaluator."
    },
    {
      "id": "distribution-policy-validation",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python scripts/validate_release_distributions.py"],
      "realized_by": "repository-program",
      "summary": "Validate repository distribution policy and require the named release record to carry usable provenance."
    },
    {
      "id": "plan-resolution",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python .github/scripts/publish_release.py resolve"],
      "realized_by": "repository-program",
      "summary": "Derive one canonical release plan from a released record at the default branch head."
    },
    {
      "id": "resolution-refusal-document",
      "origin": "orchestrator",
      "job": "resolve",
      "orchestrator_platforms": ["Linux"],
      "commands": ["jq"],
      "realized_by": "platform-toolchain",
      "summary": "Emit the bounded canonical release-result document that records a refused resolution."
    },
    {
      "id": "candidate-export",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["git worktree add", "git archive", "tar"],
      "realized_by": "platform-toolchain",
      "summary": "Export the exact candidate commit twice from the repository's own archive, plus a detached checkout for candidate verification."
    },
    {
      "id": "temporary-path-identity",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["cygpath"],
      "realized_by": "platform-toolchain",
      "summary": "Establish one canonical temporary root that every child process observes under the platform's own path spelling."
    },
    {
      "id": "pinned-build-tool-installation",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["python -m pip install"],
      "realized_by": "platform-toolchain",
      "summary": "Install the exact pinned build, setuptools, and wheel versions the release build requires."
    },
    {
      "id": "complete-candidate-qualification",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["python -m se_harness qualify complete-candidate"],
      "realized_by": "candidate-cli",
      "summary": "Qualify the complete candidate graph as candidate-controlled evidence at the exact candidate commit."
    },
    {
      "id": "candidate-unit-suite",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["python -m unittest discover"],
      "realized_by": "candidate-cli",
      "summary": "Run the candidate's own unit suite inside the exported candidate tree."
    },
    {
      "id": "cli-smoke-check",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["python -m se_harness"],
      "realized_by": "candidate-cli",
      "summary": "Confirm the candidate command-line entry point loads and reports its own usage."
    },
    {
      "id": "deterministic-build",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["python -m build"],
      "realized_by": "platform-toolchain",
      "summary": "Build exactly one wheel and one sdist per exported tree without build isolation."
    },
    {
      "id": "sdist-normalization",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["python scripts/normalize_sdist.py"],
      "realized_by": "repository-program",
      "summary": "Normalize each raw sdist with the candidate's own normalizer at the candidate commit's own timestamp."
    },
    {
      "id": "build-determinism-comparison",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["cmp"],
      "realized_by": "platform-toolchain",
      "summary": "Compare the wheel and the normalized sdist of the two independent distribution sets byte for byte."
    },
    {
      "id": "bundle-assembly",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": [],
      "realized_by": "shell-composition",
      "summary": "Assemble the release bundle directory holding the wheel, the sdist, and canonical SHA256SUMS bytes."
    },
    {
      "id": "bundle-manifest-creation",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Windows"],
      "commands": ["python scripts/create_release_bundle_manifest.py"],
      "realized_by": "repository-program",
      "summary": "Create the deterministic release-bundle manifest for the assembled distribution set."
    },
    {
      "id": "build-manifest-verification",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["python .github/scripts/publish_release.py verify-build-manifest"],
      "realized_by": "repository-program",
      "summary": "Verify the rebuilt distribution manifest field by field against the resolved plan."
    },
    {
      "id": "bundle-verification",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux", "Windows"],
      "commands": ["python .github/scripts/publish_release.py verify-bundle"],
      "realized_by": "repository-program",
      "summary": "Verify the assembled bundle's file set, digests, and canonical checksum bytes against the resolved plan."
    },
    {
      "id": "recipe-bound-build-replay",
      "origin": "orchestrator",
      "job": "qualify",
      "orchestrator_platforms": ["Linux"],
      "commands": ["python scripts/replay_release_build.py", "jq .manifest"],
      "realized_by": "repository-program",
      "summary": "Replay the bound distribution-schema-2 build recipe twice inside the recipe's own immutable linux/amd64 OCI producer and compare the result against the resolved plan. The rehearsal reports this mechanic excluded with its measured reason: the orchestrator performs it only in the recipe matrix mode on Linux, it needs a released recipe-bound subject and a container runtime, and the repository rehearses the producer replay itself in .github/workflows/release-candidate-replay.yml."
    },
    {
      "id": "teardown",
      "origin": "rehearsal-only",
      "job": null,
      "orchestrator_platforms": [],
      "commands": [],
      "realized_by": "rehearsal-program",
      "summary": "Remove every derived tree without following a link out of the rehearsal root, and leave the repository worktree free of residue. The orchestrator does not perform this mechanic because its runners are ephemeral."
    }
