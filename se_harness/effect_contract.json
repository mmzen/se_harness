{
  "schema": "se-harness-effect-contract-catalog-v1",
  "canonical_encoding": "se-harness-canonical-json-v1",
  "schemas": [
    {
      "id": "se-harness-change-bundle-v1",
      "root_fields": ["schema", "identity", "changes"],
      "identity_fields": ["work_order", "envelope_sha256", "repository_state_before"],
      "entry_fields": ["operation", "path", "before", "after"],
      "authority_fields": []
    },
    {
      "id": "se-harness-effect-journal-v1",
      "root_fields": [
        "schema",
        "repository_id",
        "session_id",
        "transaction_id",
        "state",
        "bundle_sha256",
        "envelope_sha256",
        "nonce_sha256",
        "work_order",
        "state_before",
        "state_after",
        "previous_receipt_sha256",
        "entries",
        "prior_manifest_sha256",
        "expected_manifest_sha256",
        "plan_sha256",
        "created_parents",
        "temporaries",
        "applied",
        "receipt_sha256",
        "uncertain_paths",
        "started_at"
      ],
      "terminal_states": [
        "committed",
        "human-recovery-stop",
        "recovered-prior",
        "recovered-result",
        "rolled-back"
      ],
      "authority_fields": []
    },
    {
      "id": "se-harness-effect-receipt-v1",
      "root_fields": [
        "schema",
        "operation",
        "identity",
        "entries",
        "state",
        "timing",
        "journal",
        "validation"
      ],
      "identity_fields": [
        "bundle_sha256",
        "envelope_sha256",
        "nonce_sha256",
        "work_order",
        "evaluator"
      ],
      "entry_fields": [
        "operation",
        "path",
        "before_sha256",
        "after_sha256",
        "result"
      ],
      "authority_fields": []
    }
  ],
  "operations": ["create", "delete", "replace"],
  "bounds": {
    "max_bundle_bytes": 1048576,
    "max_changes": 1024,
    "max_effect_journal_bytes": 4194304,
    "max_file_bytes": 16777216,
    "max_total_after_bytes": 67108864
  },
  "diagnostics": [
    "AEXBND001",
    "AEXBND002",
    "AEXBND003",
    "AEXBND004",
    "AEXBND005",
    "AEXBND006",
    "AEXBND007",
    "AEXBND008",
    "AEXEFF001",
    "AEXEFF002",
    "AEXEFF003",
    "AEXEFF004",
    "AEXEFF005",
    "AEXEFF006",
    "AEXEFF007",
    "AEXEFF008",
    "AEXEFF009",
    "AEXEFF010",
    "AEXEFF011",
    "AEXEFF012",
    "AEXEFF013",
    "AEXEFF014",
    "AEXEFF015"
  ]
}
