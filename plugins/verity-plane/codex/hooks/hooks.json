{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_instructions.py\" --host codex",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
